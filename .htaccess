# Force HTTPS on the canonical host
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://www.ux-guidelines.com/$1 [R=301,L]

# Extensionless and trailing-slash forms redirect to the .html address
# (/es/iconos-universales/ -> /es/iconos-universales.html; /fitts-law -> /fitts-law.html)
RewriteRule ^(fr|de|es|ja|zh)/([a-z0-9-]+)/?$ /$1/$2.html [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ /$1.html [R=301,L]

