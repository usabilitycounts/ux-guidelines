# Force HTTPS on the canonical host
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://www.ux-guidelines.com/$1 [R=301,L]

# Language-prefixed URLs serve the same page shell; tokens.js renders the
# language from the path. /fr/hicks-law.html -> hicks-law.html, /fr/ -> index.
RewriteRule ^(fr|de|es|ja|zh)/?$ index.html [L]
RewriteRule ^(fr|de|es|ja|zh)/(.+)$ $2 [L]

# Legacy short filenames from before the full-concept rename
Redirect 301 /aesthetic-usability.html https://www.ux-guidelines.com/aesthetic-usability-effect.html
